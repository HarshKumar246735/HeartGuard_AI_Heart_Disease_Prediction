# Port is injected automatically by Render. Only set locally.
PORT=5000
NODE_ENV=development
# MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Base URL of the FastAPI service (no trailing slash)
ML_SERVICE_URL=
# Allowed frontend origin(s), comma separated. e.g. https://your-app.vercel.app
CLIENT_URL=
# Optional - used only by `npm run seed`
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
